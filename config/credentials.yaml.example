# VFS Account Credentials
# Copy this file to credentials.yaml and fill in your details
# NEVER commit credentials.yaml to git!

vfs_account:
  email: "your.email@example.com"
  password: "your_password_here"

# Applicant Information - Must match VFS form fields exactly
applicant:
  # Personal Information
  first_name: "John"
  middle_name: ""  # Leave empty if not applicable
  last_name: "Doe"
  date_of_birth: "01/01/1990"  # DD/MM/YYYY format
  gender: "Male"  # Male or Female
  marital_status: "Single"  # Single, Married, Divorced, Widowed

  # Contact Information
  email: "john.doe@example.com"
  phone_country_code: "+974"
  phone_number: "12345678"
  alternate_phone: ""  # Optional

  # Address Information
  address_line1: "Building 123, Street 45"
  address_line2: "Zone 67"  # Optional
  city: "Doha"
  state: "Doha"
  postal_code: ""
  country: "Qatar"

  # Passport Information
  passport_number: "A12345678"
  passport_issue_date: "01/01/2020"  # DD/MM/YYYY
  passport_expiry_date: "01/01/2030"  # DD/MM/YYYY
  passport_issue_place: "Doha, Qatar"
  nationality: "Indian"  # Your nationality

  # Travel Information
  travel_purpose: "Tourism"  # Tourism, Business, Work, etc.
  intended_travel_date: "01/06/2024"  # DD/MM/YYYY
  intended_stay_duration: "15"  # Number of days

  # Employment Information (Required for work visa)
  occupation: "Software Engineer"
  employer_name: "Tech Company Ltd"
  employer_address: "Tech Park, Doha"
  employer_phone: "+97412345678"
  monthly_income: "15000"  # In QAR

  # Portugal Contact Information
  portugal_contact_name: "Hotel Booking"  # Or host name
  portugal_contact_address: "Lisbon, Portugal"
  portugal_contact_phone: "+351123456789"

  # Previous Visa Information (if applicable)
  previous_schengen_visa: false  # true or false
  previous_visa_number: ""
  previous_visa_issue_date: ""
  previous_visa_expiry_date: ""

# Payment Information (if auto-payment is enabled)
payment:
  auto_pay: false  # Enable only if you want automatic payment
  card_number: ""
  card_holder_name: ""
  card_expiry: ""  # MM/YY
  cvv: ""
