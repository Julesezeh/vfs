# VFS Booking Bot Configuration
# Copy this file to config.yaml and fill in your details

# VFS Website Configuration
vfs:
  base_url: "https://visa.vfsglobal.com/qat/en/prt/login"
  country_from: "qatar"
  country_to: "portugal"
  visa_type: "tourist"  # Change to "work" for work visa
  appointment_center: "Doha"  # Your preferred center

# Browser Configuration
browser:
  headless: false  # Set to true to run without GUI
  use_proxy: true
  proxy_host: ""  # e.g., "123.45.67.89"
  proxy_port: ""  # e.g., "8080"
  proxy_user: ""  # Leave empty if no auth
  proxy_pass: ""  # Leave empty if no auth
  proxy_scheme: "http"  # "http" or "https"
  window_width: 1920
  window_height: 1080
  user_agent: "auto"  # "auto" for random user agent

# Cloudflare Bypass Configuration
cloudflare:
  max_wait: 120  # Maximum time to wait for Cloudflare bypass (in seconds)
  # Note: Cloudflare challenges can take 1-2 minutes to resolve
  # Turnstile challenges may need up to 150 seconds

# Timing Configuration (in seconds) - Important for avoiding detection
timing:
  page_load_wait: [3, 6]  # Random wait between min and max
  element_wait: [1, 3]
  typing_delay: [0.1, 0.3]  # Delay between keystrokes
  click_delay: [0.5, 1.5]
  form_field_delay: [2, 4]  # Delay between form fields
  navigation_delay: [3, 5]
  screenshot_delay: 1

# Automation Settings
automation:
  max_retries: 3
  retry_delay: 300  # 5 minutes between retries
  check_interval: 3600  # Check every hour (in seconds)
  auto_book: false  # Set to true to automatically book when slot found
  continuous_mode: true  # Keep checking for appointments
  screenshot_on_error: true
  screenshot_on_success: true

# Telegram Notifications
telegram:
  enabled: true
  bot_token: "YOUR_BOT_TOKEN_HERE"
  chat_id: "YOUR_CHAT_ID_HERE"
  notify_on_start: true
  notify_on_slot_found: true
  notify_on_booking_success: true
  notify_on_error: true
  send_screenshots: true

# Logging
logging:
  level: "INFO"  # DEBUG, INFO, WARNING, ERROR
  log_to_file: true
  log_to_console: true
  log_file: "logs/vfs_bot.log"
